# portfolio-img-hosting environment
#
# Copy to .env.local and fill in. NEVER commit .env.local.
# Every variable is server-only. Do NOT prefix any of them with NEXT_PUBLIC_ —
# that inlines the value into the browser bundle.
#
# After changing any value on Vercel, redeploy: env changes don't apply to a
# running deployment.

# ── Who may embed images ─────────────────────────────────────────────────────
# Exact origins (scheme + host, no path), comma-separated. Include the portfolio
# site AND the admin panel. Changing domains later = edit this + redeploy; keep
# the old domain listed until it's retired. - this is example not real one
ALLOWED_ORIGINS="https://fsgjhdfngdf2222.tech,https://www.fsgjhdfngdf2222.tech,https://fsgjhdfngdf2222.vercel.app"

# Optional wildcards, one `*` = one DNS label fragment. Handy for Vercel preview
# deployments. Leave blank to disable.
#   e.g. https://escanor244-*.vercel.app
ALLOWED_ORIGIN_PATTERNS=""

# "true" only in local dev — allows pages served from http://localhost:* to embed. - always false
ALLOW_LOCALHOST="false"

# ── Sources, checked in this order ───────────────────────────────────────────
IMAGE_SOURCES="github,drive"

# ── GitHub stores ────────────────────────────────────────────────────────────
# Numbered groups, looked up in order 1, 2, 3 … Parsing stops at the first
# missing IMG_STORE_n_REPO, so don't leave gaps.
#
# Every store repo must be PRIVATE — a public repo's raw links bypass the guard.
# Each token: GitHub → Settings → Developer settings → Fine-grained tokens,
# Repository access: ONLY that one repo.
#   MODE rw → Repository permissions → Contents: Read and write
#   MODE ro → Repository permissions → Contents: Read-only
IMG_STORE_1_REPO="Escanor244/portfolio-img-example"
IMG_STORE_1_TOKEN=""
IMG_STORE_1_BRANCH="main"
IMG_STORE_1_DIR="img"
IMG_STORE_1_MODE="rw"
IMG_STORE_1_LABEL="Main"

# Add more later — no code change, just env + redeploy:
# IMG_STORE_2_REPO="Escanor244/portfolio-img-store-2"
# IMG_STORE_2_TOKEN=""
# IMG_STORE_2_BRANCH="main"
# IMG_STORE_2_DIR="img"
# IMG_STORE_2_MODE="rw"
# IMG_STORE_2_LABEL="Archive"

# Which store the upload form selects by default.
IMG_UPLOAD_DEFAULT_STORE="1"

# ── Google Drive (optional) ──────────────────────────────────────────────────
# Leave DRIVE_FOLDER_IDS blank and Drive is never consulted.
# Setup: Google Cloud → enable Drive API → service account → JSON key. In each
# Drive account, share a folder with the service account email as Viewer, and
# put the folder id (from its URL) here. Keep the files themselves PRIVATE.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# The JSON key's "private_key" value, base64-encoded so newlines survive:
#   node -e "console.log(Buffer.from(require('./key.json').private_key).toString('base64'))"
GOOGLE_PRIVATE_KEY_B64=""
# Comma-separated; any number of Google accounts. Earlier wins on name clashes.
DRIVE_FOLDER_IDS=""

# ── MongoDB (optional) ───────────────────────────────────────────────────────
# Caches path → store mappings and stores alt text / tags. Images still serve
# without it. Use a dedicated user whose custom role allows find, insert,
# update, remove and createIndex on portfolio.images ONLY — never the admin's
# readWrite user.
MONGODB_URI=""
MONGODB_DB="portfolio"
MONGODB_COLLECTION="images"

# ── Gallery sign-in (own values — do NOT reuse portfolio-admin's) ────────────
# Session signing key:  openssl rand -base64 32
AUTH_SECRET=""

# GitHub OAuth — OPTIONAL. Leave both blank and only the password form shows.
# New OAuth App; callback URL must match EXACTLY:
#   local       http://localhost:3000/api/auth/callback/github
#   production  https://img.escanor244.tech/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Numeric GitHub user id, not username:  gh api user --jq .id
ALLOWED_GITHUB_ID=""

# Break-glass password as an Argon2id hash:  npm run hash-password
# In .env.local every $ must be escaped as \$ (the script prints both forms).
ADMIN_PASSWORD_HASH=""

# ── Links ────────────────────────────────────────────────────────────────────
# The base the gallery uses for "Copy link". Change it with the domain.
PUBLIC_BASE_URL="https://img.fsgjhdfngdf2222.tech"

# ── Tuning / ops ─────────────────────────────────────────────────────────────
# How long Vercel's server-side cache keeps an image before asking GitHub again.
CACHE_SECONDS="3600"
# Allowed ?w= values. Anything else is refused.
IMAGE_WIDTHS="320,640,960,1280,1920"
# Lets scripts call POST /api/refresh without a session:  openssl rand -base64 32
REFRESH_SECRET=""
